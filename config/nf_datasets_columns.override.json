{
  "organizationName": "org.synapse.nf",
  "name": "nf_datasets_columns",
  "description": "Per-column analyzer assignments for the nf-datasets SearchIndex (syn75081630, source syn50913342). Roles: IDENTIFIER for id-like fields (Synapse entity ids, DOIs, URIs, checksums, file paths — preserve punctuation, no stemming); nf_scientific_synonyms for free-text scientific/discovery fields (stemming + NF synonym expansion at search time); KEYWORD for clean categorical/facet fields (exact match, incl. list-valued facets). Every other column (name, title, species, dates, numeric fields, system/bookkeeping columns) falls through to the config defaultAnalyzer (STANDARD), which tokenizes and lowercases without stemming. Columns absent from the index are silently skipped at build time.",
  "overrides": [
    { "columnName": "id", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },
    { "columnName": "studyId", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },
    { "columnName": "doi", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },
    { "columnName": "datasetMD5Hex", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },
    { "columnName": "externalRepositoryUri", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },
    { "columnName": "path", "analyzer": { "$ref": "org.sagebionetworks-IDENTIFIER" } },

    { "columnName": "description", "analyzer": { "$ref": "org.synapse.nf-nf_scientific_synonyms" } },
    { "columnName": "diseaseFocus", "analyzer": { "$ref": "org.synapse.nf-nf_scientific_synonyms" } },
    { "columnName": "manifestation", "analyzer": { "$ref": "org.synapse.nf-nf_scientific_synonyms" } },
    { "columnName": "alternateName", "analyzer": { "$ref": "org.synapse.nf-nf_scientific_synonyms" } },

    { "columnName": "creator", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "contributor", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "fundingAgency", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "dataType", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "series", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "accessType", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "license", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "visualizeDataOn", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "countryOfOrigin", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "dataUseModifiers", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "funder", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "measurementTechnique", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "assay", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "modelSystemName", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "ageGroup", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "subject", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } },
    { "columnName": "keywords", "analyzer": { "$ref": "org.sagebionetworks-KEYWORD" } }
  ]
}
